.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Artefatos intermediários do pipeline --------------------------------
# Estado de execução, recriável a qualquer momento pelos comandos.
.process-manifest.json
.search-manifest.json
.title-list-*.json
.downloads/
.extracted-text/

# --- Conteúdo dos papers --------------------------------------------------
# PDFs não vão para o repositório: são pesados, redistribuí-los pode violar
# a licença do editor, e são sempre recuperáveis pelo DOI no references.bib.
*.pdf
*.epub
*.docx

# --- Modo revisão de manuscrito -------------------------------------------
# Manuscrito inédito e PDFs de terceiros: nunca vão para o repositório.
# Só context.md, INDEX.md e reviews/ são versionados.
manuscripts/*/paper/
manuscripts/*/references/
# Figuras geradas para o manuscrito (gerador e dados ficam versionados).
manuscripts/*/adjustments/*/out/

# Mantém a estrutura de diretórios visível mesmo sem os arquivos.
!.gitkeep

# --- Credenciais -----------------------------------------------------------
# Chaves de API, contas de serviço e tokens OAuth: nunca vão para o repositório.
credentials/
.env
.env.*
*.pem
*.p12
*.key
*service-account*.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json

# --- Arquivos compactados ---------------------------------------------------
# Um zip de credentials/ ou manuscripts/ escapa das regras acima (foi assim que a
# chave e o manuscrito vazaram no commit e9db5b6). Nenhum compactado é versionado.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
__MACOSX/
